# ============================================================
# Arquivo de configuração de variáveis de ambiente
# RENOMEIE este arquivo para ".env" e preencha os valores
# NUNCA envie o arquivo .env para o GitHub (já está no .gitignore)
# ============================================================

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=cantina_escolar

# --- Flask ---
# Pode ser qualquer texto longo e aleatório
SECRET_KEY=cantina_escola_pim_2024_chave_secreta_aleatoria

# --- Login do Sistema ---
ADMIN_USER=admin
ADMIN_PASSWORD=cantina123

# --- Notificação por E-mail (Resend) ---
# PASSO 1: Crie conta em resend.com
# PASSO 2: Va em API Keys e gere uma nova chave
# PASSO 3: Cole a chave abaixo

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_DESTINATARIO=seuemail@gmail.com
