# ============================================================
# Arquivo de configuração de variáveis de ambiente
# RENOMEIE este arquivo para ".env" e preencha os valores
# NUNCA envie o arquivo .env para o GitHub (já está no .gitignore)
# ============================================================

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=cantina_escolar

# --- Flask ---
# Pode ser qualquer texto longo e aleatório
SECRET_KEY=cantina_escola_pim_2024_chave_secreta_aleatoria

# --- Notificação por E-mail (Gmail) ---
# PASSO 1: Ative a verificação em 2 etapas na sua conta Google
# PASSO 2: Acesse: myaccount.google.com > Segurança > Senhas de app
# PASSO 3: Crie uma senha de app para "Outro (nome personalizado)"
# PASSO 4: Cole o token de 16 caracteres em EMAIL_SENHA_APP abaixo

EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA_APP=xxxx xxxx xxxx xxxx
EMAIL_DESTINATARIO=diretor@escola.edu.br
